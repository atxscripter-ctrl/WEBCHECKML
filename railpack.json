{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.11"
  },
  "deploy": {
    "aptPackages": [
      "libnss3",
      "libnspr4",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libxkbcommon0",
      "libatspi2.0-0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libpango-1.0-0",
      "libcairo2",
      "libasound2",
      "libxshmfence1",
      "fonts-liberation",
      "ca-certificates"
    ],
    "startCommand": "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  },
  "steps": {
    "install": {
      "commands": [
        "pip install --no-cache-dir -r requirements.txt",
        "python -m playwright install chromium"
      ]
    }
  }
}